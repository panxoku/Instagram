{
  "mcpServers": {
    "meta-ads": {
      "command": "uv",
      "args": ["run", "--quiet", "--directory", "tools/meta-ads-mcp", "meta-ads-manager-mcp"],
      "env": {
        "META_ACCESS_TOKEN": "${META_ACCESS_TOKEN}",
        "META_AD_ACCOUNT_ID": "${META_AD_ACCOUNT_ID}",
        "META_PAGE_ID": "${META_PAGE_ID}",
        "META_INSTAGRAM_USERNAME": "${META_INSTAGRAM_USERNAME:-MagliaCL}",
        "META_INSTAGRAM_USER_ID": "${META_INSTAGRAM_USER_ID:-}",
        "META_ADS_MAX_DAILY_BUDGET_CENTS": "${META_ADS_MAX_DAILY_BUDGET_CENTS:-5000}"
      }
    }
  }
}
